<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>MIA case — {{ payload.case.name }}</title>
<style>
:root{color-scheme:dark;--bg:#07111f;--panel:#101d30;--panel2:#16263d;--text:#edf4ff;--muted:#9bb0ca;--line:#29405e;--accent:#68d8ff;--ok:#74e6a8;--warn:#ffd479;--bad:#ff8f9b;--shadow:0 20px 60px rgba(0,0,0,.28)}
[data-theme="light"]{color-scheme:light;--bg:#f4f7fb;--panel:#fff;--panel2:#edf3fa;--text:#142238;--muted:#60708a;--line:#d5deea;--accent:#006f9c;--ok:#147a45;--warn:#8b5c00;--bad:#a7192d;--shadow:0 16px 40px rgba(22,39,65,.12)}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:radial-gradient(circle at 20% -20%,rgba(104,216,255,.18),transparent 35%),var(--bg);color:var(--text);font:14px/1.5 Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif}button,input,select{font:inherit}.shell{display:grid;grid-template-columns:260px minmax(0,1fr);min-height:100vh}.side{position:sticky;top:0;height:100vh;padding:22px 18px;border-right:1px solid var(--line);background:color-mix(in srgb,var(--panel) 92%,transparent);backdrop-filter:blur(16px)}.brand{font-size:25px;font-weight:800;letter-spacing:-.03em}.alpha{display:inline-flex;margin-top:7px;padding:3px 8px;border:1px solid var(--warn);border-radius:999px;color:var(--warn);font-size:11px}.nav{margin-top:28px;display:grid;gap:7px}.nav a{color:var(--muted);text-decoration:none;padding:10px 12px;border-radius:10px}.nav a:hover,.nav a.active{background:var(--panel2);color:var(--text)}.main{padding:28px;max-width:1600px;width:100%;margin:auto}.hero{display:flex;justify-content:space-between;gap:20px;align-items:flex-start}.hero h1{font-size:clamp(30px,5vw,56px);line-height:1;margin:0;letter-spacing:-.045em}.muted{color:var(--muted)}.actions{display:flex;gap:8px;flex-wrap:wrap}.btn{border:1px solid var(--line);background:var(--panel);color:var(--text);padding:9px 12px;border-radius:10px;cursor:pointer;text-decoration:none}.btn:hover{border-color:var(--accent)}.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;margin:24px 0}.card,.panel{background:linear-gradient(145deg,color-mix(in srgb,var(--panel) 96%,white 4%),var(--panel));border:1px solid var(--line);border-radius:16px;box-shadow:var(--shadow)}.card{padding:16px}.card strong{display:block;font-size:28px;margin-top:5px}.panel{padding:18px;margin:18px 0}.panel h2{margin:0 0 14px;font-size:21px}.toolbar{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:12px}.toolbar input,.toolbar select{background:var(--panel2);color:var(--text);border:1px solid var(--line);border-radius:10px;padding:9px 11px;min-width:180px}.graph-wrap{display:grid;grid-template-columns:minmax(0,1fr) 330px;gap:14px}.graph-stage{height:590px;background:linear-gradient(180deg,rgba(104,216,255,.04),transparent),var(--panel2);border:1px solid var(--line);border-radius:14px;overflow:hidden;position:relative}.graph-stage svg{width:100%;height:100%}.node{cursor:pointer}.node circle{stroke:var(--bg);stroke-width:2}.node text{fill:var(--text);font-size:11px;pointer-events:none;text-shadow:0 1px 3px var(--bg)}.edge{stroke:var(--line);stroke-width:1.5;opacity:.75}.edge-label{fill:var(--muted);font-size:9px}.detail{background:var(--panel2);border:1px solid var(--line);border-radius:14px;padding:15px;overflow:auto;max-height:590px}.detail pre,.raw pre{white-space:pre-wrap;overflow-wrap:anywhere;background:var(--bg);padding:10px;border-radius:10px;max-height:260px;overflow:auto}.pill{display:inline-flex;padding:3px 8px;border-radius:999px;background:var(--panel2);border:1px solid var(--line);font-size:11px;margin:2px}.high{color:var(--ok)}.medium{color:var(--warn)}.low,.very-low{color:var(--bad)}.timeline{position:relative;padding-left:24px}.timeline:before{content:"";position:absolute;left:7px;top:7px;bottom:7px;width:2px;background:var(--line)}.event{position:relative;padding:0 0 20px 8px}.event:before{content:"";position:absolute;left:-22px;top:5px;width:12px;height:12px;border-radius:50%;background:var(--accent);box-shadow:0 0 0 4px var(--panel)}.finding-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:10px}.finding{padding:14px;background:var(--panel2);border:1px solid var(--line);border-radius:12px}.finding h3{margin:0 0 5px}.finding.hidden{display:none}.run{border-top:1px solid var(--line);padding:12px 0}.run:first-child{border-top:0}.raw summary{cursor:pointer;color:var(--accent)}.summary-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:12px}.summary-section{background:var(--panel2);border-radius:12px;padding:14px}.summary-section h3{margin-top:0}.summary-section li{margin-bottom:9px}.warning{border-left:4px solid var(--warn);padding-left:12px}.screens{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:10px}.screens img{max-width:100%;border-radius:10px;border:1px solid var(--line)}code{background:var(--panel2);padding:2px 5px;border-radius:5px}a{color:var(--accent)}.hidden{display:none!important}@media(max-width:1000px){.shell{grid-template-columns:1fr}.side{position:relative;height:auto;border-right:0;border-bottom:1px solid var(--line)}.nav{display:flex;overflow:auto}.graph-wrap{grid-template-columns:1fr}.detail{max-height:none}.main{padding:20px}}@media print{.side,.actions,.toolbar{display:none}.shell{display:block}.panel,.card{box-shadow:none}.graph-stage{height:500px}}
</style>
</head>
<body>
<div class="shell">
<aside class="side">
<div class="brand">MIA WORKBENCH</div><span class="alpha">POWERED BY MIA CORE · EARLY ALPHA</span>
<p class="muted">Advanced evidence-first investigation workspace.</p>
<nav class="nav">
<a href="#overview">Overview</a><a href="#graph">Evidence graph</a><a href="#timeline">Timeline</a><a href="#findings">Entities</a><a href="#verification">Verification</a><a href="#clusters">Identity clusters</a><a href="#review">Manual review</a><a href="#assistant">Assistant</a><a href="#runs">Plugin logs</a><a href="#attachments">Evidence files</a><a href="#notes">Notes</a><a href="#exports">Exports</a>
</nav>
<p class="muted" style="margin-top:28px">Automated results are leads, not proof. Verify manually and use only for lawful, authorized purposes.</p>
</aside>
<main class="main">
<section id="overview" class="hero"><div><div class="muted">{{ payload.case.case_id }}</div><h1>{{ payload.case.name }}</h1><p>{{ payload.case.description or "Persistent investigation workspace" }}</p></div><div class="actions"><button class="btn" id="theme">Toggle theme</button><button class="btn" onclick="window.print()">Print/PDF</button></div></section>
<div class="stats"><div class="card"><span class="muted">Entities</span><strong>{{ payload.nodes|length }}</strong></div><div class="card"><span class="muted">Relationships</span><strong>{{ payload.edges|length }}</strong></div><div class="card"><span class="muted">Scans</span><strong>{{ payload.scans|length }}</strong></div><div class="card"><span class="muted">Verified candidates</span><strong>{{ payload.verifications|length }}</strong></div><div class="card"><span class="muted">Identity clusters</span><strong>{{ payload.clusters|length }}</strong></div><div class="card"><span class="muted">Review tasks</span><strong>{{ payload.review_tasks|length }}</strong></div><div class="card"><span class="muted">Timeline events</span><strong>{{ payload.timeline|length }}</strong></div><div class="card"><span class="muted">Cross-case links</span><strong>{{ payload.correlations|length }}</strong></div></div>
<section id="graph" class="panel"><h2>Interactive evidence graph</h2><div class="toolbar"><input id="graph-search" placeholder="Find node…"><select id="graph-type"><option value="">All entity types</option></select><button class="btn" id="reset-graph">Reset layout</button></div><div class="graph-wrap"><div class="graph-stage"><svg id="graph-svg" aria-label="Evidence graph"></svg></div><aside class="detail" id="node-detail"><h3>Select an entity</h3><p class="muted">Click a node or relationship to inspect its evidence and confidence explanation.</p></aside></div></section>
<section id="timeline" class="panel"><h2>Timeline</h2><div class="timeline" id="timeline-list"></div></section>
<section id="findings" class="panel"><h2>Entities</h2><div class="toolbar"><input id="entity-search" placeholder="Filter entities…"><select id="entity-type"><option value="">All types</option></select></div><div class="finding-grid" id="entity-grid"></div></section>
{% if payload.deep_seeds %}<section class="panel"><h2>Deep case inputs</h2><p class="muted">These are investigator-supplied leads and context, not proof that they belong to one identity.</p><div class="finding-grid">{% for seed in payload.deep_seeds %}<article class="finding"><h3>{{ seed.label or seed.target }}</h3><div class="muted">{{ seed.target }}</div><p><span class="pill">{{ seed.target_type }}</span>{% if seed.subject %}<span class="pill">{{ seed.subject }}</span>{% endif %}</p>{% if seed.notes %}<p>{{ seed.notes }}</p>{% endif %}</article>{% endfor %}</div></section>{% endif %}
<section id="verification" class="panel"><h2>Profile verification</h2><p class="muted">Discovery hits are candidates. Verification checks whether a real, inspectable account appears to exist and records bounded snapshots.</p><div class="finding-grid">{% for item in payload.verifications %}<article class="finding"><h3>{{ item.platform }} · {{ item.status }}</h3><div class="muted">{{ item.url }}</div><p><span class="pill {{ 'high' if item.score >= 0.85 else 'medium' if item.score >= 0.65 else 'low' }}">{{ (item.score * 100)|round|int }}%</span>{% if item.response_status %}<span class="pill">HTTP {{ item.response_status }}</span>{% endif %}</p>{% if item.reasons %}<ul>{% for reason in item.reasons %}<li>{{ reason }}</li>{% endfor %}</ul>{% endif %}{% if item.negative_reasons %}<div class="warning"><ul>{% for reason in item.negative_reasons %}<li>{{ reason }}</li>{% endfor %}</ul></div>{% endif %}{% if item.changed_fields %}<p>Changed since prior snapshot: {{ item.changed_fields|join(', ') }}</p>{% endif %}</article>{% else %}<p class="muted">No profile verification has been run. Use <code>mia case verify CASE</code>.</p>{% endfor %}</div></section>
<section id="clusters" class="panel"><h2>Identity clusters</h2><p class="muted">Clusters are hypotheses built from explainable similarities and contradictions. They are not identity proof.</p><div class="finding-grid">{% for cluster in payload.clusters %}<article class="finding"><h3>{{ cluster.label }}</h3><p><span class="pill {{ 'high' if cluster.confidence >= 0.85 else 'medium' if cluster.confidence >= 0.65 else 'low' }}">{{ (cluster.confidence * 100)|round|int }}%</span><span class="pill">{{ cluster.node_ids|length }} profiles</span></p>{% if cluster.reasons %}<h4>Supporting</h4><ul>{% for reason in cluster.reasons %}<li>{{ reason }}</li>{% endfor %}</ul>{% endif %}{% if cluster.contradictions %}<h4>Contradictions</h4><div class="warning"><ul>{% for item in cluster.contradictions %}<li>{{ item }}</li>{% endfor %}</ul></div>{% endif %}</article>{% else %}<p class="muted">No multi-profile identity clusters currently meet the configured threshold.</p>{% endfor %}</div></section>
<section id="review" class="panel"><h2>Manual review queue</h2><div class="finding-grid">{% for task in payload.review_tasks %}<article class="finding"><h3>{{ task.title }}</h3><p><span class="pill">{{ task.priority }}</span><span class="pill">{{ task.status }}</span></p><p>{{ task.description }}</p><p class="muted">{{ task.recommended_action }}</p><code>{{ task.task_id }}</code></article>{% else %}<p class="muted">No review tasks have been generated.</p>{% endfor %}</div></section>
<section id="assistant" class="panel"><h2>Evidence-grounded assistant</h2><div id="assistant-content"></div>{% if payload.analysis %}<h3>Latest multi-pass analysis</h3><p>Provider: <code>{{ payload.analysis.provider }}</code> · Depth: <code>{{ payload.analysis.depth }}</code></p><div class="summary-grid">{% for title,key in [('Identity assessments','identity_assessments'),('Contradictions','contradictions'),('False-positive warnings','false_positive_warnings'),('Recommended workflow','recommended_workflow')] %}<div class="summary-section"><h3>{{ title }}</h3><ul>{% for item in payload.analysis[key] %}<li>{{ item.text }}<br><span class="muted">Evidence: {{ item.evidence_ids|join(', ') }}</span></li>{% else %}<li class="muted">No grounded statements.</li>{% endfor %}</ul></div>{% endfor %}</div>{% endif %}</section>
<section id="runs" class="panel"><h2>Plugin runs and raw excerpts</h2><div id="run-list"></div></section>
<section id="notes" class="panel"><h2>Case notes</h2><pre>{{ payload.notes }}</pre></section>
{% if payload.attachments %}<section id="attachments" class="panel"><h2>Evidence files and screenshots</h2><div class="finding-grid">{% for item in payload.attachments %}<article class="finding"><h3>{{ item.filename }}</h3><p><span class="pill">{{ item.kind }}</span> <span class="muted">{{ item.size_bytes }} bytes</span></p><p><code>{{ item.sha256 }}</code></p>{% if item.note %}<p>{{ item.note }}</p>{% endif %}<a href="../{{ item.kind if item.kind == 'evidence' else 'screenshots' }}/{{ item.filename }}">Open attachment</a></article>{% endfor %}</div></section>{% endif %}
{% if payload.screenshots %}<section class="panel"><h2>Screenshots</h2><div class="screens">{% for image in payload.screenshots %}<figure><img src="../screenshots/{{ image }}" alt="{{ image }}"><figcaption>{{ image }}</figcaption></figure>{% endfor %}</div></section>{% endif %}
<section id="exports" class="panel"><h2>Exports</h2><div class="actions">{% for label,path in payload.exports.items() %}<a class="btn" href="{{ path }}">{{ label }}</a>{% endfor %}</div></section>
</main></div>
<script id="mia-data" type="application/json">{{ payload|tojson }}</script>
<script>
(()=>{const D=JSON.parse(document.getElementById('mia-data').textContent);const $=s=>document.querySelector(s),$$=s=>[...document.querySelectorAll(s)];const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));const conf=c=>c>=0.85?'high':c>=0.65?'medium':c>=0.4?'low':'very-low';
const theme=localStorage.getItem('mia-theme');if(theme)document.documentElement.dataset.theme=theme;$('#theme').onclick=()=>{const next=document.documentElement.dataset.theme==='light'?'dark':'light';document.documentElement.dataset.theme=next;localStorage.setItem('mia-theme',next)};
const types=[...new Set(D.nodes.map(n=>n.entity_type))].sort();for(const id of ['graph-type','entity-type']){const el=$('#'+id);types.forEach(t=>el.insertAdjacentHTML('beforeend',`<option value="${esc(t)}">${esc(t)}</option>`))}
const color=t=>{let h=0;for(const c of t)h=(h*31+c.charCodeAt(0))%360;return `hsl(${h} 72% 58%)`};let positions={};const svg=$('#graph-svg');function layout(){const w=svg.clientWidth||900,h=svg.clientHeight||590,n=D.nodes.length;positions={};D.nodes.forEach((node,i)=>{const a=(i/Math.max(n,1))*Math.PI*2,r=Math.min(w,h)*(.18+.25*((i%5)/5));positions[node.node_id]={x:w/2+Math.cos(a)*r,y:h/2+Math.sin(a)*r,vx:0,vy:0}});for(let k=0;k<120;k++){for(const e of D.edges){const a=positions[e.source_node_id],b=positions[e.target_node_id];if(!a||!b)continue;const dx=b.x-a.x,dy=b.y-a.y,d=Math.max(1,Math.hypot(dx,dy)),f=(d-120)*.002;a.vx+=dx/d*f;a.vy+=dy/d*f;b.vx-=dx/d*f;b.vy-=dy/d*f}for(let i=0;i<D.nodes.length;i++)for(let j=i+1;j<D.nodes.length;j++){const a=positions[D.nodes[i].node_id],b=positions[D.nodes[j].node_id],dx=b.x-a.x,dy=b.y-a.y,d=Math.max(12,Math.hypot(dx,dy)),f=180/(d*d);a.vx-=dx/d*f;a.vy-=dy/d*f;b.vx+=dx/d*f;b.vy+=dy/d*f}for(const p of Object.values(positions)){p.vx+=(w/2-p.x)*.0008;p.vy+=(h/2-p.y)*.0008;p.x=Math.max(25,Math.min(w-25,p.x+p.vx));p.y=Math.max(25,Math.min(h-25,p.y+p.vy));p.vx*=.82;p.vy*=.82}}draw()}
function draw(){const q=$('#graph-search').value.toLowerCase(),type=$('#graph-type').value,visible=new Set(D.nodes.filter(n=>(!type||n.entity_type===type)&&(!q||(n.label+' '+n.value).toLowerCase().includes(q))).map(n=>n.node_id));let out='';for(const e of D.edges){if(!visible.has(e.source_node_id)||!visible.has(e.target_node_id))continue;const a=positions[e.source_node_id],b=positions[e.target_node_id];out+=`<g data-edge="${e.edge_id}"><line class="edge" x1="${a.x}" y1="${a.y}" x2="${b.x}" y2="${b.y}"/><text class="edge-label" x="${(a.x+b.x)/2}" y="${(a.y+b.y)/2}">${esc(e.label)}</text></g>`}for(const n of D.nodes){if(!visible.has(n.node_id))continue;const p=positions[n.node_id],r=n.attributes?.root_target?13:8+Math.round(n.confidence*4);out+=`<g class="node" data-node="${n.node_id}" transform="translate(${p.x},${p.y})"><circle r="${r}" fill="${color(n.entity_type)}"/><text x="${r+4}" y="4">${esc(n.label.slice(0,32))}</text></g>`}svg.innerHTML=out;$$('[data-node]').forEach(el=>el.onclick=()=>showNode(el.dataset.node));$$('[data-edge]').forEach(el=>el.onclick=()=>showEdge(el.dataset.edge))}
function showNode(id){const n=D.nodes.find(x=>x.node_id===id);if(!n)return;$('#node-detail').innerHTML=`<h3>${esc(n.label)}</h3><p><span class="pill">${esc(n.entity_type)}</span> <span class="pill ${conf(n.confidence)}">${Math.round(n.confidence*100)}%</span></p><p>${esc(n.value)}</p><h4>Sources</h4><p>${n.sources.map(x=>`<span class="pill">${esc(x)}</span>`).join('')}</p><h4>Evidence</h4><p>${n.evidence_refs.map(x=>`<code>${esc(x)}</code>`).join('<br>')||'No evidence path recorded'}</p><h4>Attributes</h4><pre>${esc(JSON.stringify(n.attributes,null,2))}</pre>`}
function showEdge(id){const e=D.edges.find(x=>x.edge_id===id);if(!e)return;$('#node-detail').innerHTML=`<h3>${esc(e.label)}</h3><p><span class="pill">${esc(e.relation)}</span> <span class="pill ${conf(e.confidence)}">${Math.round(e.confidence*100)}%</span></p><h4>Why MIA linked these</h4><ul>${e.reasons.map(x=>`<li>${esc(x)}</li>`).join('')}</ul><h4>Confidence factors</h4>${e.factors.map(f=>`<div class="finding"><strong>${esc(f.label)}</strong><div class="muted">${esc(f.explanation)}</div><span class="pill">${esc(f.effect)} ${Math.round(f.weight*100)}%</span></div>`).join('')}`}
$('#graph-search').oninput=draw;$('#graph-type').onchange=draw;$('#reset-graph').onclick=layout;window.addEventListener('resize',()=>setTimeout(layout,100));
const entityGrid=$('#entity-grid');function renderEntities(){const q=$('#entity-search').value.toLowerCase(),type=$('#entity-type').value;entityGrid.innerHTML=D.nodes.filter(n=>!n.attributes?.root_target).filter(n=>(!type||n.entity_type===type)&&(!q||(n.label+' '+n.value+' '+n.sources.join(' ')).toLowerCase().includes(q))).map(n=>`<article class="finding" data-id="${n.node_id}"><h3>${esc(n.label)}</h3><div class="muted">${esc(n.value)}</div><p><span class="pill">${esc(n.entity_type)}</span><span class="pill ${conf(n.confidence)}">${Math.round(n.confidence*100)}%</span></p><p>${n.sources.map(x=>`<span class="pill">${esc(x)}</span>`).join('')}</p></article>`).join('')||'<p class="muted">No matching entities.</p>';$$('#entity-grid .finding').forEach(el=>el.onclick=()=>{showNode(el.dataset.id);location.hash='graph'})}$('#entity-search').oninput=renderEntities;$('#entity-type').onchange=renderEntities;
$('#timeline-list').innerHTML=D.timeline.length?D.timeline.map(e=>`<div class="event"><strong>${esc(e.title)}</strong><div class="muted">${esc(new Date(e.occurred_at).toLocaleString())} · ${esc(e.source||'unknown source')}</div></div>`).join(''):'<p class="muted">No dated evidence has been extracted yet.</p>';
function section(title,items){return `<div class="summary-section"><h3>${title}</h3>${items?.length?`<ul>${items.map(x=>`<li>${esc(x.text)}<br><span class="muted">Evidence: ${x.evidence_ids.map(esc).join(', ')||'none'}</span></li>`).join('')}</ul>`:'<p class="muted">No grounded statements.</p>'}</div>`}const A=D.assistant;$('#assistant-content').innerHTML=A?`<p class="muted">Provider: ${esc(A.provider)}${A.rejected_ungrounded_statements?` · rejected ungrounded statements: ${A.rejected_ungrounded_statements}`:''}</p><div class="summary-grid">${section('Executive summary',A.executive_summary)}${section('Notable findings',A.notable_findings)}${section('Uncertainty warnings',A.uncertainty_warnings)}${section('Suggested next steps',A.suggested_next_steps)}</div>`:'<p class="muted">No assistant summary has been generated. Run <code>mia case summarize CASE</code>.</p>';
$('#run-list').innerHTML=D.plugin_runs.map(r=>`<article class="run"><strong>${esc(r.plugin_name)}</strong> <span class="pill">${esc(r.status)}</span>${r.cached?'<span class="pill">cached</span>':''}<div class="muted">Target ${esc(r.target)} · scan ${esc(r.scan_id)} · ${r.duration_seconds.toFixed(1)}s · ${r.finding_count} findings</div>${r.error?`<p class="warning">${esc(r.error)}</p>`:''}${r.warnings?.length?`<ul>${r.warnings.map(x=>`<li>${esc(x)}</li>`).join('')}</ul>`:''}<div class="raw">${r.stdout_excerpt?`<details><summary>stdout excerpt</summary><pre>${esc(r.stdout_excerpt)}</pre></details>`:''}${r.stderr_excerpt?`<details><summary>stderr excerpt</summary><pre>${esc(r.stderr_excerpt)}</pre></details>`:''}${r.raw_files?.map(f=>`<details><summary>raw/${esc(f.path)}</summary><pre>${esc(f.excerpt)}</pre></details>`).join('')||''}</div></article>`).join('')||'<p class="muted">No plugin runs recorded.</p>';
renderEntities();layout();document.addEventListener('keydown',e=>{if(e.key==='/'&&document.activeElement.tagName!=='INPUT'){e.preventDefault();$('#entity-search').focus()}if(e.key==='g')location.hash='graph';if(e.key==='t')location.hash='timeline'});
})();
</script>
</body></html>
